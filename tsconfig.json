{
  "compilerOptions": {
    /* La app corre en el navegador y se compila con Vite, que borra los tipos
       sin verificarlos. Acá `tsc --noEmit` es la verificación: la puerta del
       CI, no el compilador que produce dist/. */
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* `vite/client` es lo que declara import.meta.glob, que usa
       ui/categorias para descubrir las fotos sin listarlas a mano. */
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Sin allowJs: no queda ningún .js en src ni en tests. Un archivo nuevo
       tiene que ser .ts o el build no lo resuelve. */
    "allowJs": false
  },
  "include": ["src", "vite.config.ts"]
}
